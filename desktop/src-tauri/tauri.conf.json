{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AkaDesk Desktop Shell",
  "version": "0.1.0",
  "identifier": "com.akadesk.desktop_shell",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AkaDesk",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  }
}
